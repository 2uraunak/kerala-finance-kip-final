# PostgreSQL
POSTGRES_USER=kip
POSTGRES_PASSWORD=kip_secret
POSTGRES_DB=kipdb

# MinIO (local S3)
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin123

# JWT (change in production!)
JWT_SECRET=supersecret_jwt_key_change_in_prod

# Ollama model (options: llama3.2, mistral, gemma2)
OLLAMA_MODEL=llama3.2

# Embedding model (local sentence-transformers)
EMBED_MODEL=all-MiniLM-L6-v2

# Log level
LOG_LEVEL=INFO
